@model List<ProductViewModel>
@{
    ViewData["Title"] = "Товары";
}

<section class="cyber-section" style="padding-top: 60px;">
    <div class="container">
        <div class="row g-4">

            @await Html.PartialAsync("SideBar")

            <div class="col-lg-10 col-md-9">
                <div class="d-flex align-items-end justify-content-between mb-5 flex-wrap gap-3">
                    <div>
                        <span class="cyber-eyebrow">// ПАНЕЛЬ АДМИНИСТРАТОРА</span>
                        <h1 class="cyber-title mt-2">Товары <span class="cyber-accent-text">каталога</span></h1>
                    </div>
                    <a class="cyber-btn cyber-btn-accent"
                       asp-area="Admin" asp-controller="Product" asp-action="Add">
                        <i class="bi bi-plus-lg me-2"></i>Добавить товар
                    </a>
                </div>

                @if (Model != null && Model.Count > 0)
                {
                    <div class="cyber-table-wrap reveal">
                        <table class="cyber-table w-100">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Наименование</th>
                                    <th>Цена</th>
                                    <th>Главная</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Count; i++)
                                {
                                    <tr>
                                        <td class="cyber-table-num">@(i + 1)</td>
                                        <td>
                                            <a asp-area="" asp-controller="Product"
                                               asp-action="Index" asp-route-Id="@Model[i].Id"
                                               style="color: var(--c-accent);">
                                                @Model[i].Name
                                            </a>
                                        </td>
                                        <td class="cyber-table-total">@Model[i].Cost.ToString("c")</td>
                                        <td>
                                            @if (Model[i].IsOnMainPage)
                                            {
                                                <span class="cyber-status-badge">На главной</span>
                                            }
                                            else
                                            {
                                                <span style="color:var(--c-muted); font-size:0.75rem;">—</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a class="cyber-btn cyber-btn-ghost"
                                                   style="padding:0.3rem 0.8rem; font-size:0.65rem;"
                                                   asp-area="Admin" asp-controller="Product"
                                                   asp-action="Update" asp-route-Id="@Model[i].Id">
                                                    <i class="bi bi-pencil me-1"></i>Изменить
                                                </a>
                                                <a class="cyber-btn"
                                                   style="padding:0.3rem 0.8rem; font-size:0.65rem; background:rgba(255,60,80,0.08); border-color:rgba(255,60,80,0.3); color:#ff4060;"
                                                   data-bs-target="#delProduct_@i" data-bs-toggle="modal">
                                                    <i class="bi bi-trash3 me-1"></i>Удалить
                                                </a>
                                            </div>

                                            <!-- Модалка удаления -->
                                            <div class="modal fade" id="delProduct_@i" tabindex="-1"
                                                 data-bs-backdrop="static" data-bs-keyboard="false">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content cyber-modal">
                                                        <div class="modal-header cyber-modal-header">
                                                            <span class="cyber-eyebrow">// УДАЛЕНИЕ ТОВАРА</span>
                                                        </div>
                                                        <form method="post">
                                                            <div class="modal-body cyber-modal-body">
                                                                Вы действительно хотите удалить товар
                                                                <strong style="color:var(--c-accent);">@Model[i].Name</strong>?
                                                            </div>
                                                            <div class="modal-footer cyber-modal-footer">
                                                                <button class="cyber-btn"
                                                                        style="background:rgba(255,60,80,0.1); border-color:rgba(255,60,80,0.4); color:#ff4060;"
                                                                        type="submit"
                                                                        asp-area="Admin" asp-controller="Product"
                                                                        asp-action="Delete" asp-route-Id="@Model[i].Id">
                                                                    <i class="bi bi-trash3 me-2"></i>Удалить
                                                                </button>
                                                                <button class="cyber-btn cyber-btn-ghost"
                                                                        type="button" data-bs-dismiss="modal">
                                                                    Отмена
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2"></td>
                                    <td colspan="3" class="cyber-table-sum">
                                        Всего товаров: <span>@Model.Count</span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="cyber-empty-state reveal text-center">
                        <i class="bi bi-box cyber-empty-icon"></i>
                        <h4 class="cyber-title mt-3">Товаров пока нет</h4>
                        <a class="cyber-btn cyber-btn-accent mt-4"
                           asp-area="Admin" asp-controller="Product" asp-action="Add">
                            <i class="bi bi-plus-lg me-2"></i>Добавить товар
                        </a>
                    </div>
                }
            </div>

        </div>
    </div>
</section>