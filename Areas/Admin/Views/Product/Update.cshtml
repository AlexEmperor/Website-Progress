@model ProductViewModel
@{
    ViewData["Title"] = "Редактирование товара";
}

<section class="cyber-section" style="padding-top: 60px;">
    <div class="container">
        <div class="row g-4">

            @await Html.PartialAsync("SideBar")

            <div class="col-lg-10 col-md-9">
                <div class="d-flex align-items-center justify-content-between mb-5 flex-wrap gap-3">
                    <div>
                        <span class="cyber-eyebrow">// ПАНЕЛЬ АДМИНИСТРАТОРА</span>
                        <h1 class="cyber-title mt-2">Редактирование <span class="cyber-accent-text">товара</span></h1>
                    </div>
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                       class="cyber-btn cyber-btn-outline">
                        <i class="bi bi-arrow-left me-2"></i>К товарам
                    </a>
                </div>

                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-4">

                        <div class="col-lg-7">
                            <div class="cyber-contact-card reveal">
                                <span class="cyber-eyebrow mb-4 d-block">// ДАННЫЕ ТОВАРА</span>
                                <div class="text-danger mb-3" asp-validation-summary="All"></div>

                                <div class="cyber-form-group">
                                    <label class="cyber-label" asp-for="Name"></label>
                                    <input class="cyber-input" asp-for="Name" />
                                    <span class="cyber-validation" asp-validation-for="Name"></span>
                                </div>
                                <div class="cyber-form-group">
                                    <label class="cyber-label" asp-for="Cost"></label>
                                    <input type="number" class="cyber-input" asp-for="Cost" />
                                    <span class="cyber-validation" asp-validation-for="Cost"></span>
                                </div>
                                <div class="cyber-form-group">
                                    <label class="cyber-label" asp-for="ShortDescription"></label>
                                    <textarea class="cyber-input cyber-textarea" asp-for="ShortDescription">@Model.ShortDescription</textarea>
                                    <span class="cyber-validation" asp-validation-for="ShortDescription"></span>
                                </div>
                                <div class="cyber-form-group">
                                    <label class="cyber-label" asp-for="Description"></label>
                                    <textarea class="cyber-input cyber-textarea" asp-for="Description">@Model.Description</textarea>
                                    <span class="cyber-validation" asp-validation-for="Description"></span>
                                </div>

                                <span class="cyber-corner tl"></span>
                                <span class="cyber-corner br"></span>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <div class="cyber-contact-card reveal">
                                <span class="cyber-eyebrow mb-4 d-block">// ФАЙЛЫ</span>

                                <div class="cyber-form-group">
                                    <label class="cyber-label d-block mb-2">Текущие фото</label>

                                    @{
                                        var existingPhotos = (Model.PhotoPath ?? "")
                                        .Split(';', StringSplitOptions.RemoveEmptyEntries)
                                        .Select(p => p.Trim())
                                        .Where(p => !string.IsNullOrEmpty(p))
                                        .ToList();
                                    }

                                    @if (existingPhotos.Any())
                                    {
                                        <div class="cyber-photo-grid mb-2">
                                            @for (int i = 0; i < existingPhotos.Count; i++)
                                            {
                                                var path = existingPhotos[i];
                                                var inputId = $"delPhoto_{i}";
                                                <div class="cyber-photo-thumb @(i == 0 ? "is-cover" : "")">
                                                    <img src="@path" alt="photo" />
                                                    @if (i == 0)
                                                    {
                                                        <span class="cyber-photo-badge">ОБЛОЖКА</span>
                                                    }
                                                    <label class="cyber-photo-delete" for="@inputId">
                                                        <input type="checkbox" id="@inputId"
                                                               name="photosToDelete" value="@path" />
                                                        <span><i class="bi bi-trash"></i> Удалить</span>
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                        <p class="cyber-text" style="font-size:0.78rem; opacity:.65;">
                                            Первое фото — обложка. Отметьте те, которые нужно удалить.
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="cyber-text" style="font-size:0.85rem; opacity:.7;">Фото не загружены</p>
                                    }
                                </div>

                                <div class="cyber-form-group">
                                    <label class="cyber-label">Добавить новые фото</label>
                                    <input type="file" class="cyber-input" name="PhotoFiles" multiple accept="image/*" />
                                </div>
                                <div class="cyber-form-group">
                                    <label class="cyber-label">Презентация</label>
                                    <input type="file" class="cyber-input" asp-for="PresentationFile" />
                                </div>
                                <div class="cyber-form-group">
                                    <label class="cyber-label">Прошивка</label>
                                    <input type="file" class="cyber-input" asp-for="FirmwareFile" />
                                </div>

                                <span class="cyber-corner tl"></span>
                                <span class="cyber-corner br"></span>
                            </div>

                            <!-- Главная страница -->
                            <div class="cyber-contact-card reveal mt-4">
                                <span class="cyber-eyebrow mb-3 d-block">// ОТОБРАЖЕНИЕ</span>
                                <p class="cyber-text mb-3" style="font-size:0.85rem;">
                                    Показывать товар в секции «Новинки» на главной странице
                                </p>
                                <button type="submit" class="cyber-btn w-100 justify-content-center
                                    @(Model.IsOnMainPage ? "cyber-btn-outline" : "cyber-btn-accent")"
                                        name="toggleMainPage" value="true">
                                    @if (Model.IsOnMainPage)
                                    {
                                        <i class="bi bi-eye-slash me-2"></i>
                                    
                                        <span>Скрыть с главной</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-eye me-2"></i>
                                    
                                        <span>Показать на главной</span>
                                    }
                                </button>
                                <span class="cyber-corner tl"></span>
                                <span class="cyber-corner br"></span>
                            </div>
                        </div>

                        <!-- Кнопка сохранить -->
                        <div class="col-12 reveal">
                            <div class="d-flex gap-3 justify-content-end"
                                 style="border-top: 1px solid var(--c-border); padding-top: 1.5rem;">
                                <button class="cyber-btn cyber-btn-accent cyber-btn-lg" type="submit">
                                    <i class="bi bi-check2 me-2"></i>Сохранить изменения
                                </button>
                            </div>
                        </div>

                    </div>
                </form>
            </div>

        </div>
    </div>
</section>
@section Styles {
    <style>
        .cyber-photo-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .cyber-photo-thumb {
            position: relative;
            width: 100%;
            padding-top: 100%; /* квадрат через padding-hack, работает везде */
            border: 1px solid var(--c-border);
            border-radius: var(--radius-md, 10px);
            overflow: hidden;
            background: rgba(0,0,0,.25);
        }

            .cyber-photo-thumb.is-cover {
                border-color: #00ff9c;
                box-shadow: 0 0 0 1px rgba(0,255,156,.3);
            }

            .cyber-photo-thumb img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .cyber-photo-badge {
            position: absolute;
            top: 6px;
            left: 6px;
            background: #00ff9c;
            color: #000;
            font-size: .62rem;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
            letter-spacing: .05em;
            z-index: 2;
        }

        .cyber-photo-delete {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0,0,0,.7);
            color: #fff;
            padding: 5px 7px;
            font-size: .75rem;
            display: flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            user-select: none;
            margin: 0;
            z-index: 2;
        }

            .cyber-photo-delete input {
                accent-color: #ff4757;
                cursor: pointer;
                margin: 0;
            }

        .cyber-photo-thumb:has(input:checked) {
            opacity: .45;
            border-color: #ff4757;
        }

            .cyber-photo-thumb:has(input:checked) img {
                filter: grayscale(1);
            }

        @@media (max-width: 576px) {
            .cyber-photo-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
}