@model List<AdminUserViewModel>
@{
    ViewData["Title"] = "Пользователи";
}

<section class="cyber-section" style="padding-top: 60px;">
    <div class="container">
        <div class="row g-4">

            @await Html.PartialAsync("SideBar")

            <div class="col-lg-10 col-md-9">
                <div class="d-flex align-items-end justify-content-between mb-5 flex-wrap gap-3">
                    <div>
                        <span class="cyber-eyebrow">// ПАНЕЛЬ АДМИНИСТРАТОРА</span>
                        <h1 class="cyber-title mt-2">Пользователи <span class="cyber-accent-text">системы</span></h1>
                    </div>
                    <a class="cyber-btn cyber-btn-accent"
                       asp-area="Admin" asp-controller="User" asp-action="Add">
                        <i class="bi bi-person-plus me-2"></i>Добавить пользователя
                    </a>
                </div>

                @if (Model != null && Model.Count > 0)
                {
                    <div class="cyber-table-wrap reveal">
                        <table class="cyber-table w-100">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Логин</th>
                                    <th>Роль</th>
                                    <th>Имя</th>
                                    <th>Фамилия</th>
                                    <th>Телефон</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Count; i++)
                                {
                                    <tr>
                                        <td class="cyber-table-num">@(i + 1)</td>
                                        <td>
                                            <a asp-area="Admin" asp-controller="User"
                                               asp-action="Detail" asp-route-id="@Model[i].Id"
                                               style="color: var(--c-accent);">
                                                @Model[i].Login
                                            </a>
                                        </td>
                                        <td><span class="cyber-status-badge">@Model[i].Role</span></td>
                                        <td class="cyber-table-price">@Model[i].FirstName</td>
                                        <td class="cyber-table-price">@Model[i].LastName</td>
                                        <td class="cyber-table-price">@Model[i].Phone</td>
                                        <td>
                                            <a class="cyber-btn cyber-btn-ghost"
                                               style="padding:0.3rem 0.8rem; font-size:0.65rem;"
                                               asp-area="Admin" asp-controller="User"
                                               asp-action="Detail" asp-route-id="@Model[i].Id">
                                                Подробнее <i class="bi bi-arrow-right ms-1"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3"></td>
                                    <td colspan="4" class="cyber-table-sum">
                                        Всего пользователей: <span>@Model.Count</span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="cyber-empty-state reveal text-center">
                        <i class="bi bi-people cyber-empty-icon"></i>
                        <h4 class="cyber-title mt-3">Пользователей пока нет</h4>
                        <a class="cyber-btn cyber-btn-accent mt-4"
                           asp-area="Admin" asp-controller="User" asp-action="Add">
                            <i class="bi bi-person-plus me-2"></i>Добавить пользователя
                        </a>
                    </div>
                }
            </div>

        </div>
    </div>
</section>