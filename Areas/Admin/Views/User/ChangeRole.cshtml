@model ChangeRole
@{
    ViewData["Title"] = "Смена прав доступа";
}

<section class="cyber-section" style="padding-top: 60px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-4 col-md-6">
                <div class="cyber-contact-card reveal">
                    <span class="cyber-eyebrow mb-3 d-block">// АДМИНИСТРАТОР</span>
                    <h1 class="cyber-title mb-4">Права <span class="cyber-accent-text">доступа</span></h1>

                    <form method="post">
                        <div class="text-danger mb-3" asp-validation-summary="All"></div>
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <input type="hidden" name="Login" value="@Model.Login" />

                        <div class="cyber-form-group">
                            <label class="cyber-label">Роль пользователя</label>
                            <select class="cyber-input" asp-for="Role"
                                    asp-items="@Model.Roles">
                            </select>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button class="cyber-btn cyber-btn-accent cyber-btn-lg" type="submit">
                                <i class="bi bi-shield-check me-2"></i>Обновить
                            </button>
                            <a asp-area="Admin" asp-controller="User" asp-action="Index"
                               class="cyber-btn cyber-btn-ghost">
                                Отмена
                            </a>
                        </div>
                    </form>

                    <span class="cyber-corner tl"></span>
                    <span class="cyber-corner tr"></span>
                    <span class="cyber-corner bl"></span>
                    <span class="cyber-corner br"></span>
                </div>
            </div>
        </div>
    </div>
</section>