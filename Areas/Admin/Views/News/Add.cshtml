@model NewsViewModel
@{
    ViewData["Title"] = "Добавление товара";
}

<div class="text-center text-uppercase text-success mb-5 mt-5">
    <h2 class="row-title">Добавление новости</h2>
</div>

<form method="post" enctype="multipart/form-data">
    <div class="row justify-content-center mt-3">
        <div class="col-6 mb-3">
            <div class="text-danger fw-bold text-uppercase" asp-validation-summary="All"></div>

            <p>
                <label class="form-label" asp-for="Title"></label><br />
                <input class="form-control" asp-for="Title" />
            </p>
            <p>
                <label class="form-label" asp-for="Description"></label><br />
                <textarea class="form-control" asp-for="Description"></textarea>
            </p>
            <p>
                <label class="form-label" asp-for="Date"></label><br />
                <input class="form-control" asp-for="Date" />
                <span asp-validation-for="Date"></span>
            </p>
            <p>
                <label>Фото</label>
                <input type="file" class="form-control" asp-for="ImageFile" />
            </p>
        </div>
    </div>
    <div class="text-center m-3">
        <button class="btn btn-outline-success" type="submit">
            Добавить
        </button>
    </div>
</form>