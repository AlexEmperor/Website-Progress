@model List<OrderViewModel>
@{
    ViewData["Title"] = "Мои заказы";
}

<section class="cyber-section" style="padding-top: 60px;">
    <div class="container">
        <div class="row g-4">

            @await Html.PartialAsync("SideBar")

            <div class="col-lg-10 col-md-9">
                <div class="cyber-section-header mb-5">
                    <span class="cyber-eyebrow">// ЛИЧНЫЙ КАБИНЕТ</span>
                    <h1 class="cyber-title mt-2">Мои <span class="cyber-accent-text">заказы</span></h1>
                </div>

                @if (Model != null && Model.Count > 0)
                {
                    <div class="cyber-table-wrap reveal">
                        <table class="cyber-table w-100">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Сумма</th>
                                    <th>Статус</th>
                                    <th>Email</th>
                                    <th>Дата</th>
                                    <th>Время</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Count; i++)
                                {
                                    <tr>
                                        <td class="cyber-table-num">@(i + 1)</td>
                                        <td class="cyber-table-total">@Model[i].TotalCost?.ToString("c")</td>
                                        <td>
                                            <span class="cyber-status-badge">
                                                @Html.DisplayFor(model => Model[i].Status)
                                            </span>
                                        </td>
                                        <td class="cyber-table-price">@Model[i].DeliveryUser.Email</td>
                                        <td class="cyber-table-price">@Model[i].CreationDateTime.ToShortDateString()</td>
                                        <td class="cyber-table-price">@Model[i].CreationDateTime.ToShortTimeString()</td>
                                        <td>
                                            <a class="cyber-btn cyber-btn-ghost"
                                               style="padding: 0.3rem 0.8rem; font-size:0.65rem;"
                                               asp-area="User"
                                               asp-controller="Order"
                                               asp-action="Detail"
                                               asp-route-OrderId="@Model[i].Id">
                                                Подробнее <i class="bi bi-arrow-right ms-1"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4"></td>
                                    <td colspan="3" class="cyber-table-sum">
                                        Всего заказов: <span>@Model.Count</span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="cyber-empty-state reveal text-center">
                        <i class="bi bi-inbox cyber-empty-icon"></i>
                        <h4 class="cyber-title mt-3">Заказов пока нет</h4>
                        <p class="cyber-text mt-2">Перейдите в каталог и оформите первый заказ</p>
                        <a class="cyber-btn cyber-btn-accent mt-4"
                           asp-controller="Catalog"
                           asp-action="Index">
                            <i class="bi bi-grid me-2"></i>В каталог
                        </a>
                    </div>
                }
            </div>

        </div>
    </div>
</section>