<!-- =============================
     HERO
============================= -->
<section class="cyber-hero" id="hero">
    <canvas id="particleCanvas" class="cyber-particles"></canvas>
    <div class="cyber-grid-bg"></div>

    <div class="container position-relative z-2">
        <div class="row justify-content-center text-center">
            <div class="col-lg-9">

                <div class="cyber-hero-badge mb-4">
                    <span class="cyber-badge-dot"></span>
                    БЕСПРОВОДНЫЕ СИСТЕМЫ СВЯЗИ
                </div>

                <h1 class="cyber-hero-title" data-glitch="Лаборатория разработок систем беспроводной связи">
                    Лаборатория разработок<br>
                    <span class="cyber-accent-text">систем беспроводной связи</span>
                </h1>

                <p class="cyber-hero-sub mx-auto mt-4">
                    Разработка и производство оборудования<br>
                    для радиосвязи, видеопередачи и мониторинга
                </p>

                <div class="d-flex justify-content-center gap-3 mt-5 flex-wrap">
                    <a class="cyber-btn cyber-btn-accent cyber-btn-lg" asp-controller="Catalog" asp-action="Index">
                        <i class="bi bi-grid-fill me-2"></i>Перейти в каталог
                    </a>
                    <a href="#faq" class="cyber-btn cyber-btn-outline cyber-btn-lg">
                        <i class="bi bi-chat-dots me-2"></i>Задать вопрос
                    </a>
                </div>

                <div class="cyber-stats d-flex justify-content-center gap-5 mt-5 flex-wrap">
                    <div class="cyber-stat">
                        <span class="cyber-stat-num" data-count="100">0</span><span class="text-success">+</span>
                        <div class="cyber-stat-label">Проектов</div>
                    </div>
                    <div class="cyber-stat">
                        <span class="cyber-stat-num" data-count="5">0</span>
                        <div class="cyber-stat-label">Лет опыта</div>
                    </div>
                    <div class="cyber-stat">
                        <span class="cyber-stat-num" data-count="50">0</span><span class="text-success">+</span>
                        <div class="cyber-stat-label">Клиентов</div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="cyber-hero-fade"></div>
</section>

<!-- SOLUTIONS -->
<section class="cyber-section reveal" id="about">
    <div class="container">
        <div class="cyber-section-header text-center mb-5">
            <span class="cyber-eyebrow">// О НАС</span>
            <h2 class="cyber-title mt-2">Решения, которые <span class="cyber-accent-text">реально работают</span></h2>
            <p class="cyber-text mx-auto mt-3" style="max-width:650px">
                Практичные и надёжные системы связи для реальных проектов:
                БПЛА, видеопередача, радиомониторинг и спецкомплексы.
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="cyber-feature-card reveal delay-1">
                    <div class="cyber-feature-icon"><i class="bi bi-cpu-fill"></i></div>
                    <h5>Собственная разработка</h5>
                    <p class="cyber-text">Полный контроль архитектуры и программного обеспечения</p>
                    <div class="cyber-card-glow"></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cyber-feature-card reveal delay-2">
                    <div class="cyber-feature-icon"><i class="bi bi-sliders2-vertical"></i></div>
                    <h5>Адаптация под задачу</h5>
                    <p class="cyber-text">Настройка оборудования под требования заказчика</p>
                    <div class="cyber-card-glow"></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cyber-feature-card reveal delay-3">
                    <div class="cyber-feature-icon"><i class="bi bi-headset"></i></div>
                    <h5>Поддержка проектов</h5>
                    <p class="cyber-text">Сопровождение на всех этапах внедрения</p>
                    <div class="cyber-card-glow"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ПРОИЗВОДИМ В РОССИИ -->
<section class="cyber-section cyber-section-alt reveal">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="cyber-eyebrow">// ПРОИЗВОДСТВО</span>
                <h2 class="cyber-title mt-2">Производим <span class="cyber-accent-text">в России</span></h2>
                <p class="cyber-text mt-3">
                    Полный цикл разработки: от идеи и прототипа до серийного выпуска и внедрения в проекты заказчиков.
                </p>
                <ul class="cyber-list mt-4">
                    <li><i class="bi bi-check2-circle text-success me-2"></i>Собственное конструкторское бюро</li>
                    <li><i class="bi bi-check2-circle text-success me-2"></i>Серийное производство</li>
                    <li><i class="bi bi-check2-circle text-success me-2"></i>Тестирование и контроль качества</li>
                </ul>
            </div>
            <div class="col-lg-6">
                <div class="cyber-carousel-wrap">
                    <div id="productionCarousel" class="carousel slide" data-bs-interval="4000" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <img src="/img/product4.png" class="d-block w-100" alt="Производство">
                            </div>
                            <div class="carousel-item">
                                <img src="/img/product3.png" class="d-block w-100" alt="Сборка">
                            </div>
                            <div class="carousel-item">
                                <img src="/img/product4.png" class="d-block w-100" alt="Тестирование">
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#productionCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#productionCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    </div>
                    <span class="cyber-corner tl"></span>
                    <span class="cyber-corner tr"></span>
                    <span class="cyber-corner bl"></span>
                    <span class="cyber-corner br"></span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- НАШИ НОВИНКИ -->
<section class="cyber-section reveal">
    <div class="container">
        <div class="cyber-section-header text-center mb-5">
            <span class="cyber-eyebrow">// ПРОДУКЦИЯ</span>
            <h2 class="cyber-title mt-2">Наши <span class="cyber-accent-text">новинки</span></h2>
        </div>
        <div class="row g-4">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="col-md-4">
                    <div class="cyber-product-card reveal">
                        <div class="cyber-product-img-wrap">
                            <img src="@product.PhotoPath" alt="@product.Name">
                            <div class="cyber-product-overlay">
                                <a asp-controller="Product" asp-action="Index" asp-route-id="@product.Id" class="cyber-btn cyber-btn-accent">
                                    Подробнее
                                </a>
                            </div>
                        </div>
                        <div class="cyber-product-body">
                            <h5 class="cyber-product-name">@product.Name</h5>
                            <p class="cyber-text">@product.ShortDescription</p>
                        </div>
                        <span class="cyber-corner tl"></span>
                        <span class="cyber-corner br"></span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- НОВОСТИ -->
<section class="cyber-section cyber-section-alt reveal">
    <div class="container">
        <div class="d-flex align-items-end justify-content-between mb-5 flex-wrap gap-3">
            <div>
                <span class="cyber-eyebrow">// НОВОСТИ</span>
                <h2 class="cyber-title mt-2">Последние <span class="cyber-accent-text">новости</span></h2>
            </div>
            <a asp-controller="News" asp-action="All" class="cyber-btn cyber-btn-outline">
                Все новости <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-4">
            @foreach (var item in Model.News)
            {
                <div class="col-md-4">
                    <a asp-controller="News" asp-action="Index" asp-route-id="@item.Id" class="cyber-news-link">
                        <div class="cyber-news-card reveal">
                            <div class="cyber-news-img">
                                <img src="@item.ImagePath" alt="@item.Title">
                                <div class="cyber-news-date">@item.Date.ToString("dd MMM yyyy")</div>
                            </div>
                            <div class="cyber-news-body">
                                <h5 class="cyber-news-title">@item.Title</h5>
                                <span class="cyber-read-more">Читать <i class="bi bi-arrow-right"></i></span>
                            </div>
                            <span class="cyber-corner tl"></span>
                            <span class="cyber-corner br"></span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

