<!-- FAQ -->
<section class="cyber-section cyber-section-alt reveal">
    <div class="container">
        <div class="cyber-section-header text-center mb-5">
            <span class="cyber-eyebrow">// FAQ</span>
            <h2 id="faq" class="cyber-title mt-2">Часто задаваемые <span class="cyber-accent-text">вопросы</span></h2>
        </div>
        <div class="accordion cyber-accordion" id="faqAccordion">
            <div class="accordion-item cyber-accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed cyber-accordion-btn" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                        <span class="cyber-faq-num">01</span>
                        Где производится оборудование?
                    </button>
                </h2>
                <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body cyber-accordion-body">
                        Всё оборудование разрабатывается и производится на территории Российской Федерации.
                    </div>
                </div>
            </div>
            <div class="accordion-item cyber-accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed cyber-accordion-btn" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                        <span class="cyber-faq-num">02</span>
                        Можно ли заказать индивидуальную разработку?
                    </button>
                </h2>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body cyber-accordion-body">
                        Да, мы выполняем разработку оборудования под задачи заказчика.
                    </div>
                </div>
            </div>
            <div class="accordion-item cyber-accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed cyber-accordion-btn" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                        <span class="cyber-faq-num">03</span>
                        Как связаться с менеджером?
                    </button>
                </h2>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body cyber-accordion-body">
                        Через почту <a class="footer-link mail-link">electriks0comp26@gmail.com</a>
                        <small class="copy-feedback"></small>
                        или <a class="footer-link tg-link">Telegram.</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
