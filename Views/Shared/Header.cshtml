<header class="navbar sticky-top shadow p-2" data-bs-theme="dark">
    <div class="container-fluid d-flex align-items-center">

        <!-- Логотип слева -->
        <a class="navbar-brand me-4" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="/img/Logo3.svg" alt="Лаборатория разработок" width="80" height="80">
        </a>


        <!-- Слева: пустой flex, чтобы оттолкнуть кнопки вправо -->
        <div class="d-flex ms-auto align-items-center me-3">

            <!-- Кнопка "Каталог" с Dropdown mega-menu -->
            <div class="dropdown me-2">
                <button class="btn btn-success dropdown-toggle " type="button" id="catalogDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-list"></i> Каталог
                </button>

                <div class="dropdown-menu p-4 dropdown-menu-start" style="min-width: 500px;">
                    <div class="row">
                        <div class="col-6">
                            <h6 class="dropdown-header">Перехват и подмена видео</h6>
                            <a class="dropdown-item" href="#">Зеркальца</a>
                            <a class="dropdown-item" href="#">Диспетчеры</a>
                            <a class="dropdown-item" href="#">Талисманы</a>
                            <a class="dropdown-item" href="#">Сыщики</a>
                        </div>
                        <div class="col-6">
                            <h6 class="dropdown-header">Электроника и связь для БПЛА</h6>
                            <a class="dropdown-item" href="#">Аналоговая видеосвязь</a>
                            <a class="dropdown-item" href="#">Электроника для БПЛА</a>
                            <a class="dropdown-item" href="#">Мониторы No Blue</a>
                            <a class="dropdown-item" href="#">Антенны и фильтры</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Кнопка "Меню" -->
            <div class="dropdown me-2">
                <button class="btn btn-dark dropdown-toggle text-white" type="button" id="menuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-list"></i> Меню
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menuDropdown">
                    <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">Главная</a></li>
                    <li><a class="dropdown-item" asp-area="" asp-controller="Catalog" asp-action="Index">Каталог</a></li>
                    <li><a class="dropdown-item" asp-area="" asp-controller="Cart" asp-action="Index">Корзина</a></li>
                    <li><a class="dropdown-item" asp-area="" asp-controller="News" asp-action="All">Новости</a></li>
                    <li><a class="dropdown-item" asp-area="" asp-controller="Contacts" asp-action="Index">Контакты</a></li>
                </ul>
            </div>

            <!-- Кнопка "Личный кабинет" -->
            <!-- Иконка профиля -->
            <div class="dropdown me-3">
                <button class="btn btn-dark dropdown-toggle d-flex align-items-center"
                        type="button"
                        id="profileDropdown"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">

                    <i class="bi bi-person-circle fs-4"></i>
                </button>

                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">

                    @if (User.Identity.IsAuthenticated)
                    {
                        <li>
                            <span class="dropdown-item-text text-success">
                                @User.Identity.Name
                            </span>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        @if (User.IsInRole(Constants.UserRoleName))
                        {
                            <li>
                                <a class="dropdown-item"
                                asp-area="User"
                                asp-controller="Order"
                                asp-action="Index">
                                    Личный кабинет
                                </a>
                            </li>
                        }

                        @if (User.IsInRole(Constants.AdminRoleName))
                        {
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Admin"
                                   asp-controller="Order"
                                   asp-action="Index">
                                    Панель администратора
                                </a>
                            </li>
                        }

                        <li>
                            <a class="dropdown-item"
                            asp-area=""
                               asp-controller="Account"
                               asp-action="Logout">
                                Выйти
                            </a>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="dropdown-item"
                               asp-controller="Account"
                               asp-action="Autorization">
                                Войти
                            </a>
                        </li>
                    }

                </ul>
            </div>

            <button id="themeToggle" class="btn btn-outline-light me-2">
                <i class="bi bi-moon-stars-fill"></i>
            </button>

            <!-- Поиск -->
            <form class="d-flex" style="width: 50%;" asp-controller="Home" asp-action="Search" method="get">
                <input class="form-control me-2 search-input" type="search" placeholder="Введите ваш запрос" aria-label="Search" name="query">
                <button class="btn btn-success" type="submit"><i class="bi bi-search"></i></button>
            </form>

        </div>

    </div>
</header>
