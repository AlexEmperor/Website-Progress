<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
     @RenderSection("Styles", required: false) 
    <!-- Bootstrap CSS и Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="icon" type="image/png" href="/favicon-96x96.png?v=3" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="shortcut icon" href="/favicon.ico?v=3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="stylesheet" href="~/css/cyber.css" />
    <link rel="stylesheet" href="~/Website_Progress.styles.css" asp-append-version="true" />
</head>
<body>

    @await Html.PartialAsync("Header")

    <main role="main">
        @RenderBody()
    </main>

    @await Html.PartialAsync("Footer")

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Cyber JS (частицы, счётчики, скролл) -->
    <script src="~/js/cyber.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

        // THEME TOGGLE
        const btn = document.getElementById("themeToggle");
        const savedTheme = localStorage.getItem("theme");

        // По умолчанию тёмная
        if (savedTheme === "light") {
            document.body.classList.add("light");
            document.body.classList.remove("dark");
            if (btn) btn.innerHTML = '<i class="bi bi-moon-stars-fill"></i>';
        } else {
            document.body.classList.remove("light");
            if (btn) btn.innerHTML = '<i class="bi bi-sun-fill"></i>';
        }

        if (btn) {
            btn.addEventListener("click", function () {
                if (document.body.classList.contains("light")) {
                    document.body.classList.remove("light");
                    localStorage.setItem("theme", "dark");
                    btn.innerHTML = '<i class="bi bi-sun-fill"></i>';
                } else {
                    document.body.classList.add("light");
                    localStorage.setItem("theme", "light");
                    btn.innerHTML = '<i class="bi bi-moon-stars-fill"></i>';
                }
            });
        }

            // ======================
            // TELEGRAM LINKS
            // ======================
            const tgLinks = document.querySelectorAll('.tg-link');
            const username = 'DevelopmentLab_Bot';
            tgLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    window.open(`https://t.me/${username}?start=site`, '_blank');
                });
            });

            // ======================
            // MAIL LINKS (копирование)
            // ======================
            document.querySelectorAll('.mail-link').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const email = this.getAttribute('data-email') || 'electriks0comp26@gmail.com';

                    let feedback = null;
                    let el = this.parentElement;
                    while (el && !feedback) {
                        feedback = el.querySelector('.copy-feedback');
                        el = el.parentElement;
                    }

                    navigator.clipboard.writeText(email).then(() => {
                        if (!feedback) return;
                        feedback.textContent = 'Скопировано!';
                        feedback.style.display = 'inline';
                        feedback.style.opacity = 1;
                        setTimeout(() => {
                            feedback.style.opacity = 0;
                            setTimeout(() => {
                                feedback.style.display = 'none';
                                feedback.textContent = '';
                            }, 300);
                        }, 1500);
                    }).catch(err => console.error('Ошибка копирования:', err));
                });
            });

        });

        function flipCard() {
            document.querySelector('.flip-card').classList.toggle('flipped');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
