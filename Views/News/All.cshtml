@model List<NewsViewModel>
@{
    ViewData["Title"] = "Новости";
}

<section class="cyber-section" style="padding-top: 60px;">
    <div class="container">
        <div class="cyber-section-header text-center mb-5">
            <span class="cyber-eyebrow">// МЕДИА</span>
            <h1 class="cyber-title mt-2">Новости <span class="cyber-accent-text">компании</span></h1>
        </div>
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <a asp-controller="News"
                       asp-action="Index"
                       asp-route-id="@item.Id"
                       class="cyber-news-link">
                        <div class="cyber-news-card reveal">
                            <div class="cyber-news-img">
                                <img src="@item.ImagePath" alt="@item.Title">
                                <div class="cyber-news-date">
                                    @item.Date.ToString("dd MMM yyyy")
                                </div>
                            </div>
                            <div class="cyber-news-body">
                                <h5 class="cyber-news-title">@item.Title</h5>
                                <span class="cyber-read-more">
                                    Читать <i class="bi bi-arrow-right"></i>
                                </span>
                            </div>
                            <span class="cyber-corner tl"></span>
                            <span class="cyber-corner br"></span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>