@model Autorization
@{
    ViewData["Title"] = "Вход";
}

<section class="cyber-section" style="padding-top: 80px; padding-bottom: 80px;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-4 col-md-6">

                <div class="cyber-contact-card reveal">
                    <div class="text-center mb-4">
                        <span class="cyber-eyebrow">// АККАУНТ</span>
                        <h1 class="cyber-title mt-2">Вход в <span class="cyber-accent-text">систему</span></h1>
                    </div>

                    <form method="post">
                        <div class="text-danger mb-3" asp-validation-summary="All"></div>
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <div class="cyber-form-group">
                            <label class="cyber-label" asp-for="Login"></label>
                            <input class="cyber-input" asp-for="Login" />
                            <span class="cyber-validation" asp-validation-for="Login"></span>
                        </div>

                        <div class="cyber-form-group">
                            <label class="cyber-label" asp-for="Password"></label>
                            <input class="cyber-input" asp-for="Password" />
                            <span class="cyber-validation" asp-validation-for="Password"></span>
                        </div>

                        <div class="d-flex align-items-center gap-2 mb-4">
                            <input class="cyber-checkbox" asp-for="Memorize" type="checkbox" id="memorize">
                            <label class="cyber-text" style="font-size:0.85rem; cursor:pointer;" for="memorize">
                                Запомнить меня
                            </label>
                        </div>

                        <button class="cyber-btn cyber-btn-accent cyber-btn-lg w-100 justify-content-center"
                                type="submit"
                                asp-controller="Account"
                                asp-action="Autorization">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Войти
                        </button>
                    </form>

                    <div class="text-center mt-4" style="border-top: 1px solid var(--c-border); padding-top: 1.25rem;">
                        <span class="cyber-text" style="font-size:0.85rem;">Нет аккаунта?</span>
                        <a class="cyber-btn cyber-btn-ghost mt-2 w-100 justify-content-center"
                           asp-controller="Account"
                           asp-action="Registration">
                            <i class="bi bi-person-plus me-2"></i>Зарегистрироваться
                        </a>
                    </div>

                    <span class="cyber-corner tl"></span>
                    <span class="cyber-corner tr"></span>
                    <span class="cyber-corner bl"></span>
                    <span class="cyber-corner br"></span>
                </div>

            </div>
        </div>
    </div>
</section>