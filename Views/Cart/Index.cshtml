@model CartViewModel
@{
    ViewData["Title"] = "Корзина";
}

<section class="cyber-section" style="padding-top: 60px;">
    <div class="container">

        <div class="cyber-section-header text-center mb-5">
            <span class="cyber-eyebrow">// ЗАКАЗ</span>
            <h1 class="cyber-title mt-2">Ваша <span class="cyber-accent-text">корзина</span></h1>
        </div>

        @if (Model != null && Model.Items.Count > 0)
        {
            <!-- Таблица -->
            <div class="cyber-table-wrap reveal mb-4">
                <table class="cyber-table w-100">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Наименование</th>
                            <th>Цена</th>
                            <th>Количество</th>
                            <th>Стоимость</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>
                                <td class="cyber-table-num">@(i + 1)</td>
                                <td>@Model.Items[i].Product.Name</td>
                                <td class="cyber-table-price">@Model.Items[i].Product.Cost.ToString("c")</td>
                                <td>
                                    <div class="cyber-qty">
                                        <a class="cyber-qty-btn"
                                           asp-controller="Cart"
                                           asp-action="Delete"
                                           asp-route-productId="@Model.Items[i].Product.Id">
                                            <i class="bi bi-dash"></i>
                                        </a>
                                        <span class="cyber-qty-val">@Model.Items[i].Quantity</span>
                                        <a class="cyber-qty-btn"
                                           asp-controller="Cart"
                                           asp-action="AddInCart"
                                           asp-route-productId="@Model.Items[i].Product.Id">
                                            <i class="bi bi-plus"></i>
                                        </a>
                                    </div>
                                </td>
                                <td class="cyber-table-total">@Model.Items[i].Cost.ToString("c")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3"></td>
                            <td colspan="2" class="cyber-table-sum">
                                Итого: <span>@Model.TotalCost.ToString("c")</span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Кнопки действий -->
            <div class="d-flex gap-3 justify-content-between align-items-center flex-wrap reveal"
                 style="border-top: 1px solid var(--c-border); padding-top: 1.5rem;">
                <a class="cyber-btn cyber-btn-ghost"
                   asp-controller="Cart"
                   asp-action="Clear">
                    <i class="bi bi-trash3 me-2"></i>Очистить корзину
                </a>
                <div class="d-flex gap-3 flex-wrap">
                    <a class="cyber-btn cyber-btn-outline"
                       asp-controller="Catalog"
                       asp-action="Index">
                        <i class="bi bi-grid me-2"></i>В каталог
                    </a>
                    <a class="cyber-btn cyber-btn-accent cyber-btn-lg"
                       asp-controller="Order"
                       asp-action="Index">
                        <i class="bi bi-clipboard-check me-2"></i>Оставить заявку
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Пустая корзина -->
            <div class="text-center py-5 reveal">
                <div class="cyber-empty-state">
                    <i class="bi bi-cart-x cyber-empty-icon"></i>
                    <h4 class="cyber-title mt-3">Корзина пуста</h4>
                    <p class="cyber-text mt-2">
                        Переходите в каталог и выбирайте интересующий вас товар
                    </p>
                    <a class="cyber-btn cyber-btn-accent mt-4"
                       asp-controller="Catalog"
                       asp-action="Index">
                        <i class="bi bi-grid me-2"></i>Перейти в каталог
                    </a>
                </div>
            </div>
        }

    </div>
</section>