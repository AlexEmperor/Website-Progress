@{
    ViewData["Title"] = "Заявка принята";
}

<section class="cyber-section" style="padding-top: 80px; padding-bottom: 80px;">
    <div class="container">
        <div class="text-center reveal">

            <!-- Иконка успеха -->
            <div class="cyber-success-icon mb-4">
                <i class="bi bi-check-lg"></i>
            </div>

            <span class="cyber-eyebrow">// ЗАЯВКА ПРИНЯТА</span>
            <h1 class="cyber-title mt-3 mb-2">
                Заявка <span class="cyber-accent-text">сформирована!</span>
            </h1>
            <p class="cyber-text mx-auto mt-3 mb-5" style="max-width: 480px;">
                Статус заказа можно отслеживать в личном кабинете.
                Мы свяжемся с вами в ближайшее время.
            </p>

            <!-- Кнопки -->
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a class="cyber-btn cyber-btn-outline"
                   asp-controller="Catalog"
                   asp-action="Index">
                    <i class="bi bi-grid me-2"></i>В каталог
                </a>
                <a class="cyber-btn cyber-btn-outline"
                   asp-area="User"
                   asp-controller="Order"
                   asp-action="Index">
                    <i class="bi bi-person me-2"></i>Личный кабинет
                </a>
                <a class="cyber-btn cyber-btn-accent"
                   asp-controller="Order"
                   asp-action="GenerateInvoice"
                   asp-route-id="@ViewBag.OrderId">
                    <i class="bi bi-file-earmark-text me-2"></i>Получить счёт
                </a>
            </div>

        </div>
    </div>
</section>