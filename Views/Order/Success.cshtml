@{
    ViewData["Title"] = "Оплата заказа";
}

<div class="text-center text-uppercase text-success mb-5 mt-5">
    <h2 class="row-title">Формирование заказа</h2>
</div>

<div class="text-center">
    <h2 class="row-title">Заявка сформирована!</h2>
    <h2 class="row-title">Статус заказа можно отслеживать в личном кабинете.</h2>
</div>

<div class="text-center m-2">
    <a class="btn btn-outline-success"
       asp-controller="Catalog"
       asp-action="Index">
        Вернуться в каталог
    </a>
    <a class="btn btn-outline-success"
       asp-area="User"
       asp-controller="Order"
       asp-action="Index">
        В личный кабинет
    </a>
    <a asp-controller="Order"
       asp-action="GenerateInvoice"
       asp-route-id="@ViewBag.OrderId"
       class="btn btn-outline-success mb-2 w-100">
        📄 Получить предварительный счёт
    </a>
</div>