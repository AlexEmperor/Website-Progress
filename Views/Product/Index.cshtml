@using Website_Progress.Helpers
@model ProductViewModel
@{
    ViewData["Title"] = Model?.Name;
    var content = ViewData["Content"] as ProductContent ?? new ProductContent();
}

<section class="cyber-section" style="padding-top: 60px;">
    <div class="container">

        @if (Model != null)
        {
            <div class="row g-5 justify-content-center align-items-start">

                <!-- Фото -->
                <div class="col-lg-4 col-md-5">
                    <div class="cyber-carousel-wrap cyber-photo-container reveal">
                        @{
                            var photos = (Model.PhotoPath ?? "")
                            .Split(';', StringSplitOptions.RemoveEmptyEntries)
                            .Select(p => p.Trim())
                            .Where(p => !string.IsNullOrEmpty(p))
                            .ToList();
                        }

                        <!-- СТАТУС-БЕЙДЖ -->
                        <div class="cyber-status-badge @Model.Status.GetCssClass()">
                            <i class="bi @Model.Status.GetIcon()"></i>
                            <span>@Model.Status.GetDisplayName()</span>
                        </div>

                        @if (photos.Count > 1)
                        {
                            <div id="productCarousel" class="carousel slide"
                                 data-bs-interval="5000" data-bs-ride="carousel">
                                <div class="carousel-inner">
                                    @for (int i = 0; i < photos.Count; i++)
                                    {
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <img src="@photos[i]" class="d-block w-100" alt="@Model.Name"
                                                 style="border-radius: var(--radius-lg); object-fit:cover; max-height:380px;">
                                        </div>
                                    }
                                </div>

                                <button class="carousel-control-prev" type="button"
                                        data-bs-target="#productCarousel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon"></span>
                                </button>
                                <button class="carousel-control-next" type="button"
                                        data-bs-target="#productCarousel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon"></span>
                                </button>

                                <div class="carousel-indicators">
                                    @for (int i = 0; i < photos.Count; i++)
                                    {
                                        <button type="button" data-bs-target="#productCarousel"
                                                data-bs-slide-to="@i"
                                                class="@(i == 0 ? "active" : "")"
                                                aria-label="Slide @(i + 1)"></button>
                                    }
                                </div>
                            </div>
                        }
                        else if (photos.Count == 1)
                        {
                            <img src="@photos[0]" alt="@Model.Name"
                                 class="w-100"
                                 style="border-radius: var(--radius-lg); object-fit:cover; max-height:380px;">
                        }
                        else
                        {
                            <div class="text-center p-5" style="opacity:.5;">
                                <i class="bi bi-image" style="font-size:3rem;"></i>
                                <p class="mt-2 cyber-text">Фото отсутствуют</p>
                            </div>
                        }

                    <span class="cyber-corner tl"></span>
                    <span class="cyber-corner tr"></span>
                    <span class="cyber-corner bl"></span>
                    <span class="cyber-corner br"></span>
                </div>
            </div>

            <!-- Правая колонка -->
            <div class="col-lg-7 col-md-7 d-flex flex-column gap-4">

                <div class="reveal">
                    <span class="cyber-eyebrow">// ПРОДУКТ</span>
                    <h1 class="cyber-title mt-2 mb-3">@Model.Name</h1>
                    <div class="cyber-product-price mb-4" style="font-size:1.6rem;">
                        @Model.Cost.ToString("c")
                    </div>
                    <a class="cyber-btn cyber-btn-accent cyber-btn-lg"
                       asp-controller="Cart"
                       asp-action="Add"
                       asp-route-productId="@Model.Id">
                        <i class="bi bi-cart-plus me-2"></i>Добавить в корзину
                    </a>
                </div>

                <!-- Флипкарта: короткое описание / файлы -->
                <div class="flip-card reveal" style="height: 220px;">
                    <div class="flip-card-inner" id="productCard">

                        <div class="flip-card-front cyber-contact-card h-100">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="cyber-eyebrow">// КРАТКО</span>

                                <!-- Подсказка + кнопка -->
                                <div class="cyber-flip-hint-wrap">
                                    <span class="cyber-flip-hint">
                                        Прилагаемые файлы
                                        <i class="bi bi-arrow-right"></i>
                                    </span>
                                    <button class="cyber-icon-btn cyber-flip-trigger"
                                            onclick="flipCard()"
                                            title="Открыть файлы">
                                        <i class="bi bi-paperclip"></i>
                                        <!-- орбитальные стрелочки -->
                                        <span class="cyber-orbit-arrow top"><i class="bi bi-caret-down-fill"></i></span>
                                        <span class="cyber-orbit-arrow right"><i class="bi bi-caret-left-fill"></i></span>
                                        <span class="cyber-orbit-arrow bottom"><i class="bi bi-caret-up-fill"></i></span>
                                        <span class="cyber-orbit-arrow left"><i class="bi bi-caret-right-fill"></i></span>
                                    </button>
                                </div>
                            </div>

                            <p class="cyber-text mt-3"
                               style="font-size:0.92rem; line-height:1.7; overflow:auto; max-height:140px; color: #e6edf3;">
                                @(string.IsNullOrWhiteSpace(Model.ShortDescription)
                                                                ? "Описание не указано."
                                                                : Model.ShortDescription)
                            </p>
                        </div>

                            <div class="flip-card-back cyber-contact-card h-100">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <span class="cyber-eyebrow">// ФАЙЛЫ</span>
                                    <button class="cyber-icon-btn" onclick="flipCard()" title="Назад">
                                        <i class="bi bi-arrow-left"></i>
                                    </button>
                                </div>
                                <div class="d-flex flex-column gap-2">
                                @if (!string.IsNullOrEmpty(Model.PresentationPath))
                                    {
                                        <a href="@Model.PresentationPath" download
                                           class="cyber-btn cyber-btn-outline justify-content-start">
                                            <i class="bi bi-file-earmark-slides me-2 text-success"></i>
                                            Скачать презентацию
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.FirmwarePath))
                                    {
                                        <a href="@Model.FirmwarePath" download
                                           class="cyber-btn cyber-btn-outline justify-content-start">
                                            <i class="bi bi-cpu me-2 text-success"></i>
                                            Скачать прошивку
                                        </a>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

            @* =================================================== *@
            @* ПОДРОБНОЕ ОПИСАНИЕ                                 *@
            @* =================================================== *@
            @if (content.HasStructured)
            {
                <div class="row mt-5 pt-4 reveal" style="border-top: 1px solid var(--c-border);">
                    <div class="col-12">
                        <span class="cyber-eyebrow">// ПОДРОБНОЕ ОПИСАНИЕ</span>
                        <h2 class="cyber-title mt-2 mb-4">@Model.Name</h2>
                    </div>
                </div>

                <ul class="nav cyber-tabs mb-4 reveal" role="tablist">
                    @if (content.Features.Any())
                    {
                        <li class="nav-item">
                            <button class="cyber-tab-btn active" data-bs-toggle="tab"
                                    data-bs-target="#tab-overview" type="button">
                                <i class="bi bi-broadcast me-2"></i>Возможности
                            </button>
                        </li>
                    }
                    @if (content.Highlights.Any())
                    {
                        <li class="nav-item">
                            <button class="cyber-tab-btn @(content.Features.Any() ? "" : "active")"
                                    data-bs-toggle="tab" data-bs-target="#tab-features" type="button">
                                <i class="bi bi-stars me-2"></i>Особенности
                            </button>
                        </li>
                    }
                    @if (content.Specs.Any())
                    {
                        <li class="nav-item">
                            <button class="cyber-tab-btn @(!content.Features.Any() && !content.Highlights.Any() ? "active" : "")"
                                    data-bs-toggle="tab" data-bs-target="#tab-specs" type="button">
                                <i class="bi bi-cpu me-2"></i>Характеристики
                            </button>
                        </li>
                    }
                    @if (content.UseCases.Any())
                    {
                        <li class="nav-item">
                            <button class="cyber-tab-btn @(!content.Features.Any() && !content.Highlights.Any() && !content.Specs.Any() ? "active" : "")"
                                    data-bs-toggle="tab" data-bs-target="#tab-usage" type="button">
                                <i class="bi bi-bullseye me-2"></i>Применение
                            </button>
                        </li>
                    }
                </ul>

                <div class="tab-content reveal">

                    @if (content.Features.Any())
                    {
                        <div class="tab-pane fade show active" id="tab-overview">
                            <div class="row g-3">
                                @foreach (var f in content.Features)
                                {
                                    <div class="col-md-6">
                                        <div class="cyber-feature-card h-100">
                                            <i class="bi @f.Icon cyber-feature-icon"></i>
                                            <h5 class="cyber-feature-title">@f.Title</h5>
                                            <p class="cyber-feature-text">@f.Text</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (content.Highlights.Any())
                    {
                        <div class="tab-pane fade @(!content.Features.Any() ? "show active" : "")" id="tab-features">
                            <div class="row g-3">
                                @{
                                    var half = (int)Math.Ceiling(content.Highlights.Count / 2.0);
                                    var leftCol = content.Highlights.Take(half).ToList();
                                    var rightCol = content.Highlights.Skip(half).ToList();
                                }
                                <div class="col-md-6">
                                    <ul class="cyber-list">
                                        @foreach (var h in leftCol)
                                        {
                                            <li><i class="bi bi-check2-circle text-success me-2"></i>@h</li>
                                        }
                                    </ul>
                                </div>
                                @if (rightCol.Any())
                                {
                                    <div class="col-md-6">
                                        <ul class="cyber-list">
                                            @foreach (var h in rightCol)
                                            {
                                                <li><i class="bi bi-check2-circle text-success me-2"></i>@h</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (content.Specs.Any())
                    {
                        <div class="tab-pane fade @(!content.Features.Any() && !content.Highlights.Any() ? "show active" : "")" id="tab-specs">
                            <div class="table-responsive">
                                <table class="table cyber-table align-middle">
                                    <thead>
                                        <tr>
                                            <th style="width:60px;">№</th>
                                            <th>Параметр</th>
                                            <th style="width:40%;">Значение</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in content.Specs)
                                        {
                                            <tr>
                                                <td>@s.Number</td>
                                                <td>@s.Param</td>
                                                <td>@s.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    @if (content.UseCases.Any())
                    {
                        <div class="tab-pane fade @(!content.Features.Any() && !content.Highlights.Any() && !content.Specs.Any() ? "show active" : "")" id="tab-usage">
                            <div class="row g-3">
                                @for (int i = 0; i < content.UseCases.Count; i++)
                                {
                                    var u = content.UseCases[i];
                                    <div class="col-md-6 col-lg-4">
                                        <div class="cyber-usecase-card">
                                            <div class="cyber-usecase-num">@((i + 1).ToString("D2"))</div>
                                            <h6>@u.Title</h6>
                                            <p>@u.Text</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                </div>
            }
            else if (!string.IsNullOrWhiteSpace(content.PlainText))
            {
                <!-- Fallback: обычный текст, если админ не использовал разметку -->
                <div class="row mt-5 pt-4 reveal" style="border-top: 1px solid var(--c-border);">
                    <div class="col-12">
                        <span class="cyber-eyebrow">// ОПИСАНИЕ</span>
                        <h2 class="cyber-title mt-2 mb-4">О товаре</h2>
                        <div class="cyber-plain-description">
                            @foreach (var paragraph in content.PlainText.Split('\n',
                                                StringSplitOptions.RemoveEmptyEntries))
                            {
                                <p class="cyber-text">@paragraph</p>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Кнопки навигации -->
            <div class="d-flex gap-3 justify-content-center mt-5 pt-3 reveal"
                 style="border-top: 1px solid var(--c-border);">
                <a asp-controller="Catalog" asp-action="Index" class="cyber-btn cyber-btn-outline">
                    <i class="bi bi-grid me-2"></i>Продолжить покупки
                </a>
                <a asp-controller="Home" asp-action="Index" class="cyber-btn cyber-btn-ghost">
                    <i class="bi bi-house me-2"></i>На главную
                </a>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="cyber-empty-state">
                    <i class="bi bi-exclamation-triangle cyber-empty-icon"></i>
                    <h4 class="cyber-title mt-3">Такого товара не существует</h4>
                    <a asp-controller="Catalog" asp-action="Index" class="cyber-btn cyber-btn-accent mt-4">
                        Вернуться в каталог
                    </a>
                </div>
            </div>
        }

    </div>
</section>

@section Styles {
    <style>
        /* ===== СТАТУС-БЕЙДЖ ===== */
        /* ===== СТАТУС-БЕЙДЖ ===== */
        .cyber-photo-container {
            position: relative;
        }

        .cyber-status-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 5;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px 8px 12px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-radius: 6px;
            /* Непрозрачный тёмный фон — читается на любой картинке */
            background: rgba(13, 17, 23, 0.92);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
            user-select: none;
            font-family: "Consolas", "Courier New", monospace;
            /* Цветная полоска-индикатор слева */
            border-left: 3px solid currentColor;
            color: #e6edf3; /* текст всегда светлый */
        }

            .cyber-status-badge i {
                font-size: 0.95rem;
                /* Иконка окрашена в цвет статуса через currentColor-подмену ниже */
            }

            /* Текст — всегда светлый, а цвет "статуса" применяется только к полоске и иконке */
            .cyber-status-badge span {
                color: #e6edf3;
            }

            /* ===== Цвета по статусу (влияют на border-left и иконку) ===== */
            .cyber-status-badge.status-production {
                color: #00ff9c;
                box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(0, 255, 156, 0.25);
            }

            .cyber-status-badge.status-testing {
                color: #ffb340;
            }

            .cyber-status-badge.status-manufacturing {
                color: #4fc3ff;
            }

            .cyber-status-badge.status-project {
                color: #b388ff;
            }

            .cyber-status-badge.status-development {
                color: #8b96a8;
            }

            /* Пульсация иконки для "в процессе" статусов */
            .cyber-status-badge.status-testing i,
            .cyber-status-badge.status-manufacturing i {
                animation: status-pulse 2s ease-in-out infinite;
            }

        @@keyframes status-pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }
        }

        @@media (max-width: 576px) {
            .cyber-status-badge {
                top: 8px;
                left: 8px;
                padding: 6px 10px 6px 9px;
                font-size: 0.68rem;
            }
        }
        /* ===== ПОДСКАЗКА "ПРИЛАГАЕМЫЕ ФАЙЛЫ" ===== */
        .cyber-flip-hint-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            line-height: 1; /* убираем лишнюю высоту строки у текста */
        }

        .cyber-flip-hint {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: "Consolas", "Courier New", monospace;
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--c-accent, #00ff9c);
            opacity: 0.75;
            white-space: nowrap;
            line-height: 1;
            align-self: center;
            animation: hint-pulse 2.4s ease-in-out infinite;
        }

            .cyber-flip-hint i {
                font-size: 0.85rem;
                animation: hint-arrow-nudge 1.2s ease-in-out infinite;
            }

        @@keyframes hint-pulse {
            0%, 100% {
                opacity: 0.55;
            }

            50% {
                opacity: 1;
            }
        }

        @@keyframes hint-arrow-nudge {
            0%, 100% {
                transform: translateX(0);
            }

            50% {
                transform: translateX(4px);
            }
        }

        /* Скрываем подсказку на узких экранах, чтобы не ломать верстку */
        @@media (max-width: 380px) {
            .cyber-flip-hint {
                display: none;
            }
        }

        /* ===== КНОПКА-ТРИГГЕР С ОРБИТАЛЬНЫМИ СТРЕЛКАМИ ===== */
        .cyber-flip-trigger {
            position: relative;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

            .cyber-flip-trigger:hover {
                transform: scale(1.08);
                box-shadow: 0 0 0 2px rgba(0, 255, 156, 0.25), 0 0 20px rgba(0, 255, 156, 0.4);
            }

        /* Каждая стрелка — абсолютно спозиционированный элемент вокруг кнопки */
        .cyber-orbit-arrow {
            position: absolute;
            color: var(--c-accent, #00ff9c);
            font-size: 0.7rem;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
        }

            .cyber-orbit-arrow.top {
                top: -14px;
                left: 50%;
                transform: translateX(-50%);
                animation: orbit-nudge-top 1s ease-in-out infinite;
            }

            .cyber-orbit-arrow.bottom {
                bottom: -14px;
                left: 50%;
                transform: translateX(-50%);
                animation: orbit-nudge-bottom 1s ease-in-out infinite;
            }

            .cyber-orbit-arrow.left {
                left: -14px;
                top: 50%;
                transform: translateY(-50%);
                animation: orbit-nudge-left 1s ease-in-out infinite;
            }

            .cyber-orbit-arrow.right {
                right: -14px;
                top: 50%;
                transform: translateY(-50%);
                animation: orbit-nudge-right 1s ease-in-out infinite;
            }

        /* Появляются при наведении на КНОПКУ или на ВСЮ подсказку */
        .cyber-flip-hint-wrap:hover .cyber-orbit-arrow,
        .cyber-flip-trigger:hover .cyber-orbit-arrow,
        .cyber-flip-trigger:focus-visible .cyber-orbit-arrow {
            opacity: 1;
        }

        /* Лёгкое покачивание в сторону кнопки */
        @@keyframes orbit-nudge-top {
            0%, 100% {
                transform: translateX(-50%) translateY(0);
            }

            50% {
                transform: translateX(-50%) translateY(4px);
            }
        }

        @@keyframes orbit-nudge-bottom {
            0%, 100% {
                transform: translateX(-50%) translateY(0);
            }

            50% {
                transform: translateX(-50%) translateY(-4px);
            }
        }

        @@keyframes orbit-nudge-left {
            0%, 100% {
                transform: translateY(-50%) translateX(0);
            }

            50% {
                transform: translateY(-50%) translateX(4px);
            }
        }

        @@keyframes orbit-nudge-right {
            0%, 100% {
                transform: translateY(-50%) translateX(0);
            }

            50% {
                transform: translateY(-50%) translateX(-4px);
            }
        }
        /* ===== ОСТАЛЬНЫЕ СТИЛИ ===== */
        .cyber-tabs {
            border-bottom: 1px solid var(--c-border);
            gap: .25rem;
            flex-wrap: wrap;
        }

        .cyber-tab-btn {
            background: transparent;
            border: 1px solid transparent;
            border-bottom: none;
            color: var(--c-text-muted, #8b96a8);
            padding: .6rem 1.1rem;
            font-family: inherit;
            font-size: 1rem;
            letter-spacing: .02em;
            text-transform: uppercase;
            cursor: pointer;
            transition: color .2s, background .2s, border-color .2s;
            border-radius: var(--radius-sm, 6px) var(--radius-sm, 6px) 0 0;
        }

            .cyber-tab-btn:hover {
                color: var(--c-accent, #00ff9c);
                background: rgba(0,255,156,.05);
            }

            .cyber-tab-btn.active {
                color: var(--c-accent, #00ff9c);
                border-color: var(--c-border);
                border-bottom-color: var(--c-bg, transparent);
                background: var(--c-surface, rgba(255,255,255,.03));
            }

        .cyber-feature-card {
            background: var(--c-surface, rgba(255,255,255,.03));
            border: 1px solid var(--c-border);
            border-radius: var(--radius-md, 10px);
            padding: 1.25rem;
            transition: border-color .2s, transform .2s;
        }

            .cyber-feature-card:hover {
                border-color: var(--c-accent, #00ff9c);
                transform: translateY(-2px);
            }

        .cyber-feature-icon {
            font-size: 1.75rem;
            color: var(--c-accent, #00ff9c);
            margin-bottom: .5rem;
            display: block;
        }

        .cyber-feature-title {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: .5rem;
            color: var(--c-text, #e6edf3);
        }

        .cyber-feature-text {
            font-size: 1rem;
            line-height: 1.6;
            color: var(--c-text, #e6edf3);
            margin: 0;
        }

        .cyber-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .cyber-list li {
                padding: .55rem 0;
                border-bottom: 1px dashed var(--c-border);
                font-size: 1rem;
                color: var(--c-text, #e6edf3);
            }

                .cyber-list li:last-child {
                    border-bottom: none;
                }

        .cyber-table {
            --bs-table-color: var(--c-text, #e6edf3);
            --bs-table-bg: transparent;
            --bs-table-border-color: var(--c-border);
            --bs-table-striped-color: var(--c-text, #e6edf3);
